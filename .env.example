# Viral Shorts Autopilot Environment Configuration
# Project: Viral Shorts Autopilot
# Target Audience: United States (American English)

# Google & YouTube API Credentials
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=

# SupoClip Self-Hosted or Cloud Connection
SUPOCLIP_API_URL=http://localhost:8000
